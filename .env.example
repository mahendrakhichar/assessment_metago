# ─────────────────────────────────────────────
# Metago AI Marketing Platform — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Operating mode ──────────────────────────
# Options: demo | assisted | controlled
# Default: demo (safe — no real publishing)
OPERATING_MODE=demo

# ── Application ─────────────────────────────
APP_NAME="Metago AI Marketing Platform"
APP_ENV=development
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet_key
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./metago.db
SYNC_DATABASE_URL=sqlite:///./metago.db

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM / OpenRouter ─────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=anthropic/claude-3-haiku
STRONG_LLM_MODEL=anthropic/claude-3-5-sonnet
FAST_LLM_MODEL=openai/gpt-4o-mini

# ── Social Platforms (Phase 5) ───────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# ── Storage (Phase 5) ────────────────────────
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=metago-media
S3_REGION=ap-south-1

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate Limits ──────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Budgets ──────────────────────────────────
DAILY_LLM_BUDGET_USD=10.0
MONTHLY_LLM_BUDGET_USD=200.0

# ── Initial Admin ────────────────────────────
INITIAL_ADMIN_EMAIL=admin@metago.in
INITIAL_ADMIN_PASSWORD=CHANGE_ME_strong_password
